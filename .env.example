# Base des URL canoniques, du sitemap et des métadonnées Open Graph.
NEXT_PUBLIC_APP_URL=https://sante.aamassistances.com

# Indexation par les moteurs de recherche. Absente ou différente de "true",
# le site est en noindex : un déploiement de relecture ne doit pas se
# retrouver dans Google. À passer à true le jour de la vraie mise en ligne,
# une fois les tarifs, l'agrément et les textes validés.
NEXT_PUBLIC_SITE_READY=false
